# --- Claves ---
# --- LLM (Agentes 02 Sentimiento y 03 Estratega; 01, 04 y 05 son deterministas) ---
# Proveedor: gemini | anthropic. Sin clave, los agentes LLM usan reglas deterministas (0 tokens).
LLM_PROVIDER=gemini
GEMINI_API_KEY=
STRATEGIST_MODEL=gemini-3.5-flash
STRATEGIST_FALLBACK_MODELS=["gemini-3-flash-preview","gemini-3.5-flash-lite"]
SENTIMENT_MODEL=gemini-3.5-flash-lite
SENTIMENT_FALLBACK_MODELS=["gemini-3.5-flash"]
# Solo si LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_EFFORT=medium
# Opcional para datos públicos; obligatoria para TESTNET / LIVE
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Modo de ejecución: PAPER_LIVE | TESTNET | LIVE ---
EXECUTION_MODE=PAPER_LIVE
DEFAULT_VIRTUAL_CAPITAL=10000.0

# --- Riesgo ---
MAX_RISK_PER_TRADE=0.01
MAX_DAILY_DRAWDOWN=0.03
MAX_PORTFOLIO_RISK=0.03
# Stop a break-even tras +N·R (0 = desactivado, recomendado por la calibración)
BREAKEVEN_R=0
MAX_LEVERAGE=3.0

# Pares, intervalos y parámetros: backend/core/params.py (o vista Calibración → Aplicar)

# --- Servidor público (lo rellena deploy/setup-oracle.sh) ---
# Token de acceso a la API y al dashboard. Vacío = sin autenticación (solo para 127.0.0.1).
API_TOKEN=
# Dominio para HTTPS automático (Caddy). Sin dominio propio: <ip-con-guiones>.sslip.io
DOMAIN=
